<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.report.BestSellerReportController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row revenue-filter-row">
        <DatePicker fx:id="fromDatePicker" prefWidth="170" promptText="Từ ngày" styleClass="page-date revenue-filter-date" />
        <DatePicker fx:id="toDatePicker" prefWidth="170" promptText="Đến ngày" styleClass="page-date revenue-filter-date" />
        <ComboBox fx:id="branchComboBox" promptText="Chi nhánh" prefWidth="220" styleClass="page-combo revenue-filter-combo" />
        <ComboBox fx:id="categoryComboBox" promptText="Nhóm sản phẩm" prefWidth="200" styleClass="page-combo revenue-filter-combo" />
        <Button text="Xem báo cáo" onAction="#loadReport" styleClass="primary-button revenue-report-button" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="kpi-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-blue">
            <Label text="Tổng món bán" styleClass="kpi-label" />
            <Label fx:id="totalQuantityValue" text="0" styleClass="kpi-value" />
            <Label text="+11%" styleClass="kpi-badge-up" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-green">
            <Label text="Món bán chạy nhất" styleClass="kpi-label" />
            <Label fx:id="topProductValue" text="-" styleClass="kpi-value" />
            <Label fx:id="topProductBadge" text="0 ly" styleClass="kpi-badge-neutral" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-orange">
            <Label text="Doanh thu top 10" styleClass="kpi-label" />
            <Label fx:id="topRevenueValue" text="0M" styleClass="kpi-value" />
            <Label text="72% đồ uống" styleClass="kpi-badge-neutral" />
        </VBox>
    </HBox>

    <HBox styleClass="chart-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="chart-card chart-card-large">
            <VBox spacing="4">
                <Label text="Top 10 sản phẩm bán chạy" styleClass="section-title" />
                <Label text="Sản lượng bán trong kỳ" styleClass="section-subtitle" />
            </VBox>
            <BarChart fx:id="bestSellerChart" animated="false" legendVisible="false" prefHeight="320" styleClass="report-chart">
                <xAxis>
                    <CategoryAxis label="Sản phẩm" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Số lượng" />
                </yAxis>
            </BarChart>
        </VBox>
        <VBox prefWidth="340" styleClass="info-card" spacing="12">
            <Label text="Insight bán hàng" styleClass="section-title" />
            <Label fx:id="insightLabel" text="Dữ liệu bán chạy sẽ cập nhật theo khoảng ngày, chi nhánh và nhóm sản phẩm đã chọn."
                   wrapText="true"
                   styleClass="section-subtitle" />
            <HBox>
                <Label text="Cà phê" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="coffeeShareValue" text="0%" styleClass="status-badge status-success" />
            </HBox>
            <HBox>
                <Label text="Trà" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="teaShareValue" text="0%" styleClass="status-badge status-info" />
            </HBox>
            <HBox>
                <Label text="Bánh" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="bakeryShareValue" text="0%" styleClass="status-badge status-neutral" />
            </HBox>
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Bảng xếp hạng sản phẩm" styleClass="section-title" />
            <Label text="Số lượng bán, doanh thu, tỷ trọng và xu hướng" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="bestSellerTable" prefHeight="440" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="rankColumn" text="Hạng" prefWidth="80" />
                <TableColumn fx:id="productColumn" text="Sản phẩm" prefWidth="220" />
                <TableColumn fx:id="categoryColumn" text="Nhóm" prefWidth="130" />
                <TableColumn fx:id="quantityColumn" text="Số lượng bán" prefWidth="130" />
                <TableColumn fx:id="revenueColumn" text="Doanh thu" prefWidth="140" />
                <TableColumn fx:id="shareColumn" text="Tỷ trọng" prefWidth="110" />
                <TableColumn fx:id="trendColumn" text="Xu hướng" prefWidth="130" />
            </columns>
        </TableView>
    </VBox>
</VBox>
