<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.customer.CustomerListController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row">
        <TextField fx:id="searchField" promptText="Tìm tên, SĐT, email..." prefWidth="300" styleClass="page-input" />
        <Button text="Tìm kiếm" onAction="#handleSearch" styleClass="secondary-button" />
        <ComboBox fx:id="tierFilterComboBox" promptText="Hạng khách" prefWidth="190" styleClass="page-combo" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="stats-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
            <Label text="Tổng khách hàng" styleClass="metric-label" />
            <Label fx:id="totalCustomersLabel" text="0" styleClass="metric-value" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card">
            <Label text="Khách mới tháng này" styleClass="metric-label" />
            <Label fx:id="newCustomersThisMonthLabel" text="0" styleClass="metric-value" />
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Danh sách khách hàng" styleClass="section-title" />
            <Label text="Tra cứu thông tin liên hệ và hạng thành viên" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="customerTable" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="codeColumn" text="Mã KH" prefWidth="90" />
                <TableColumn fx:id="nameColumn" text="Khách hàng" prefWidth="190" />
                <TableColumn fx:id="phoneColumn" text="Điện thoại" prefWidth="130" />
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="220" />
                <TableColumn fx:id="tierColumn" text="Hạng" prefWidth="110" />
                <TableColumn fx:id="pointsColumn" text="Điểm" prefWidth="90" />
                <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="140" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="report-controls-row">
            <Label fx:id="resultCountLabel" text="Tổng 0 khách hàng" styleClass="section-subtitle" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="previousPageButton" text="Trang trước" onAction="#handlePreviousPage" styleClass="secondary-button" />
            <Label fx:id="pageInfoLabel" text="Trang 1 / 1" styleClass="section-subtitle" />
            <Button fx:id="nextPageButton" text="Trang sau" onAction="#handleNextPage" styleClass="primary-button" />
        </HBox>
    </VBox>
</VBox>
