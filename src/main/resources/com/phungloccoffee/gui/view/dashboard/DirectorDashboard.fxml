<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.dashboard.DirectorDashboardController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row revenue-filter-row">
        <DatePicker fx:id="fromDatePicker" prefWidth="170" promptText="Từ ngày" styleClass="page-date revenue-filter-date" />
        <DatePicker fx:id="toDatePicker" prefWidth="170" promptText="Đến ngày" styleClass="page-date revenue-filter-date" />
        <ComboBox fx:id="branchFilterComboBox" promptText="Chi nhánh" prefWidth="220" styleClass="page-combo revenue-filter-combo" />
        <Button text="Xem báo cáo" onAction="#loadDashboard" styleClass="primary-button revenue-report-button" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="kpi-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-blue">
            <Label text="Tổng doanh thu" styleClass="kpi-label" />
            <Label fx:id="revenueValue" text="0M" styleClass="kpi-value" />
            <Label text="+12%" styleClass="kpi-badge-up" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-green">
            <Label text="Đơn hàng" styleClass="kpi-label" />
            <Label fx:id="orderValue" text="0" styleClass="kpi-value" />
            <Label text="+8%" styleClass="kpi-badge-up" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-orange">
            <Label text="Sản phẩm bán ra" styleClass="kpi-label" />
            <Label fx:id="productValue" text="0" styleClass="kpi-value" />
            <Label text="Trong tuần demo" styleClass="kpi-badge-neutral" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-red">
            <Label text="Cảnh báo tồn kho" styleClass="kpi-label" />
            <Label fx:id="alertValue" text="0" styleClass="kpi-value" />
            <Label text="Cần xử lý" styleClass="kpi-badge-danger" />
        </VBox>
    </HBox>

    <HBox styleClass="chart-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="chart-card chart-card-large">
            <VBox spacing="4">
                <Label text="Doanh thu theo ngày" styleClass="section-title" />
                <Label text="Đơn vị: triệu đồng trong tuần demo" styleClass="section-subtitle" />
            </VBox>
            <BarChart fx:id="branchRevenueChart"
                      animated="false"
                      legendVisible="false"
                      prefHeight="320"
                      styleClass="report-chart">
                <xAxis>
                    <CategoryAxis label="Ngày" />
                </xAxis>
                <yAxis>
                    <NumberAxis />
                </yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="340" styleClass="info-card" spacing="14">
            <VBox spacing="4">
                <Label text="Tổng quan kỳ dữ liệu" styleClass="section-title" />
                <Label text="Cập nhật theo filter đang chọn" styleClass="section-subtitle" />
            </VBox>
            <HBox>
                <Label text="Kỳ dữ liệu" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="periodInfo" text="-" styleClass="status-badge status-success" />
            </HBox>
            <HBox>
                <Label text="Chi nhánh dẫn đầu" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="topBranchInfo" text="-" styleClass="status-badge status-info" />
            </HBox>
            <HBox>
                <Label text="Sản phẩm bán chạy" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="topProductInfo" text="-" styleClass="status-badge status-success" />
            </HBox>
            <HBox>
                <Label text="Cảnh báo kho" styleClass="report-list-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="inventoryWarningInfo" text="0" styleClass="status-badge status-warning" />
            </HBox>
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Hoạt động nổi bật" styleClass="section-title" />
            <Label text="Các chỉ số vận hành theo khoảng ngày đã chọn" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="activityTable" prefHeight="300" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="branchColumn" text="Chi nhánh" prefWidth="160" />
                <TableColumn fx:id="metricColumn" text="Chỉ số" prefWidth="140" />
                <TableColumn fx:id="valueColumn" text="Giá trị" prefWidth="140" />
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="140" />
                <TableColumn fx:id="noteColumn" text="Ghi chú" prefWidth="280" />
            </columns>
        </TableView>
    </VBox>
</VBox>
