<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.branch.BranchDashboardController"
      styleClass="page-root">
    <HBox styleClass="kpi-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-blue">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Doanh thu 7 ngày" styleClass="kpi-label" />
                    <Label fx:id="revenueValueLabel" text="0M" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="revenueIcon" />
            </HBox>
            <Label fx:id="revenueGrowthLabel" text="0%" styleClass="kpi-badge-up" />
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-green">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Đơn hàng 7 ngày" styleClass="kpi-label" />
                    <Label fx:id="ordersValueLabel" text="0" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="ordersIcon" />
            </HBox>
            <Label fx:id="ordersHintLabel" text="7 ngày gần nhất" styleClass="kpi-badge-neutral" />
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-orange">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Phiếu chờ duyệt" styleClass="kpi-label" />
                    <Label fx:id="approvalValueLabel" text="0" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="approvalIcon" />
            </HBox>
            <Label fx:id="approvalHintLabel" text="Cần xử lý" styleClass="kpi-badge-warning" />
        </VBox>

        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-red">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Tồn kho cảnh báo" styleClass="kpi-label" />
                    <Label fx:id="stockWarningValueLabel" text="0" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="stockIcon" />
            </HBox>
            <Label fx:id="stockWarningHintLabel" text="Kiểm tra" styleClass="kpi-badge-danger" />
        </VBox>
    </HBox>

    <HBox styleClass="chart-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="chart-card chart-card-large">
            <VBox spacing="4">
                <Label fx:id="chartTitleLabel" text="Doanh thu theo ngày" styleClass="section-title" />
                <Label fx:id="chartSubtitleLabel" text="7 ngày gần nhất" styleClass="section-subtitle" />
            </VBox>
            <LineChart fx:id="revenueChart" animated="false" createSymbols="false" legendVisible="false" prefHeight="285" styleClass="report-chart">
                <xAxis>
                    <CategoryAxis tickLabelRotation="0" />
                </xAxis>
                <yAxis>
                    <NumberAxis />
                </yAxis>
            </LineChart>
        </VBox>

        <VBox prefWidth="330" styleClass="info-card">
            <VBox spacing="4">
                <Label text="Tình trạng phiếu kho" styleClass="section-title" />
                <Label text="Tổng hợp xử lý hiện tại của chi nhánh" styleClass="section-subtitle" />
            </VBox>
            <VBox spacing="14">
                <HBox alignment="CENTER_LEFT" styleClass="report-list-row">
                    <Label text="Chờ duyệt" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="pendingCountLabel" text="0" styleClass="badge badge-pending" />
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="report-list-row">
                    <Label text="Đã duyệt" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="approvedCountLabel" text="0" styleClass="badge badge-approved" />
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="report-list-row">
                    <Label text="Từ chối" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="rejectedCountLabel" text="0" styleClass="badge badge-rejected" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Hoạt động gần đây" styleClass="section-title" />
            <Label text="Các tác vụ mới nhất đang chờ quản lý xử lý" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="activityTable" prefHeight="310" styleClass="page-table">
            <columns>
                <TableColumn fx:id="activityColumn" text="Hoạt động" prefWidth="320" />
                <TableColumn fx:id="ownerColumn" text="Người phụ trách" prefWidth="180" />
                <TableColumn fx:id="timeColumn" text="Thời gian" prefWidth="130" />
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="160" />
            </columns>
        </TableView>
    </VBox>
</VBox>
