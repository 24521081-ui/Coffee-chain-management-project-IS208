<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.report.BranchRevenueReportController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row">
        <HBox styleClass="period-tabs">
            <Button fx:id="dayTab" text="Ngày" onAction="#handleDayPeriod" styleClass="period-tab" />
            <Button fx:id="monthTab" text="Tháng" onAction="#handleMonthPeriod" styleClass="period-tab period-tab-active" />
            <Button fx:id="quarterTab" text="Quý" onAction="#handleQuarterPeriod" styleClass="period-tab" />
            <Button fx:id="yearTab" text="Năm" onAction="#handleYearPeriod" styleClass="period-tab" />
        </HBox>
        <Region HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="branchCombo" prefWidth="210" promptText="Chi nhánh" styleClass="page-combo" />
        <DatePicker fx:id="fromDatePicker" prefWidth="160" promptText="Từ ngày" styleClass="page-date" />
        <DatePicker fx:id="toDatePicker" prefWidth="160" promptText="Đến ngày" styleClass="page-date" />
    </HBox>

    <HBox styleClass="kpi-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-blue">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Doanh thu kỳ này" styleClass="kpi-label" />
                    <Label fx:id="revenueValueLabel" text="0M" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="revenueIcon" />
            </HBox>
            <Label fx:id="revenueGrowthLabel" text="0%" styleClass="kpi-badge-up" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-green">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Đơn hàng" styleClass="kpi-label" />
                    <Label fx:id="ordersValueLabel" text="0" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="orderIcon" />
            </HBox>
            <Label fx:id="ordersGrowthLabel" text="Chưa có đơn" styleClass="kpi-badge-neutral" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-orange">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Giá trị TB/đơn" styleClass="kpi-label" />
                    <Label fx:id="avgValueLabel" text="0M" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="avgIcon" />
            </HBox>
            <Label fx:id="avgHintLabel" text="Giá trị trung bình / đơn" styleClass="kpi-badge-neutral" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-purple">
            <HBox alignment="TOP_LEFT">
                <VBox spacing="7">
                    <Label text="Tăng trưởng" styleClass="kpi-label" />
                    <Label fx:id="growthValueLabel" text="0%" styleClass="kpi-value" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <StackPane fx:id="growthIcon" />
            </HBox>
            <Label fx:id="growthHintLabel" text="So với kỳ trước" styleClass="kpi-badge-neutral" />
        </VBox>
    </HBox>

    <HBox styleClass="chart-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="chart-card chart-card-large">
            <VBox spacing="4">
                <Label text="Xu hướng doanh thu" styleClass="section-title" />
                <Label fx:id="chartSubtitleLabel" text="Theo khoảng thời gian đã chọn" styleClass="section-subtitle" />
            </VBox>
            <LineChart fx:id="revenueLineChart" animated="false" createSymbols="false" legendVisible="false" prefHeight="280" styleClass="report-chart">
                <xAxis>
                    <CategoryAxis />
                </xAxis>
                <yAxis>
                    <NumberAxis />
                </yAxis>
            </LineChart>
        </VBox>

        <VBox prefWidth="340" styleClass="info-card">
            <VBox spacing="4">
                <Label text="Phạm vi báo cáo" styleClass="section-title" />
                <Label text="Dữ liệu thật của chi nhánh đang đăng nhập" styleClass="section-subtitle" />
            </VBox>
            <VBox spacing="16">
                <VBox spacing="7">
                    <HBox><Label text="Chi nhánh" styleClass="report-list-label" /><Region HBox.hgrow="ALWAYS" /><Label text="Hiện tại" styleClass="report-percent-label" /></HBox>
                    <StackPane styleClass="mini-progress-track"><Region maxWidth="220" styleClass="mini-progress-fill mini-progress-fill-success" /></StackPane>
                </VBox>
            </VBox>
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" styleClass="table-header">
            <Label text="Chi tiết doanh thu" styleClass="section-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="tablePeriodLabel" text="Chi nhánh hiện tại" styleClass="section-subtitle" />
        </HBox>
        <TableView fx:id="revenueTable" prefHeight="330" styleClass="page-table">
            <columns>
                <TableColumn fx:id="dateColumn" text="Ngày" prefWidth="120" />
                <TableColumn fx:id="revenueColumn" text="Doanh thu" prefWidth="170" />
                <TableColumn fx:id="orderColumn" text="Đơn hàng" prefWidth="120" />
                <TableColumn fx:id="avgColumn" text="Giá trị TB" prefWidth="150" />
                <TableColumn fx:id="growthColumn" text="Tăng trưởng" prefWidth="130" />
                <TableColumn fx:id="noteColumn" text="Ghi chú" prefWidth="260" />
            </columns>
        </TableView>
    </VBox>
</VBox>
