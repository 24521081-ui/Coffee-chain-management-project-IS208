<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.report.InventoryReportController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row revenue-filter-row">
        <DatePicker fx:id="fromDatePicker" prefWidth="170" promptText="Từ ngày" styleClass="page-date revenue-filter-date" />
        <DatePicker fx:id="toDatePicker" prefWidth="170" promptText="Đến ngày" styleClass="page-date revenue-filter-date" />
        <ComboBox fx:id="branchFilterComboBox" promptText="Chi nhánh" prefWidth="220" styleClass="page-combo revenue-filter-combo" />
        <ComboBox fx:id="categoryFilterComboBox" promptText="Nhóm nguyên liệu" prefWidth="200" styleClass="page-combo revenue-filter-combo" />
        <ComboBox fx:id="statusFilterComboBox" promptText="Trạng thái" prefWidth="180" styleClass="page-combo revenue-filter-combo" />
        <Button text="Xem báo cáo" onAction="#loadReport" styleClass="primary-button revenue-report-button" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="kpi-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-blue">
            <Label text="Tổng sản phẩm theo dõi" styleClass="kpi-label" />
            <Label fx:id="trackedValue" text="0" styleClass="kpi-value" />
            <Label text="Theo filter hiện tại" styleClass="kpi-badge-neutral" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-orange">
            <Label text="Chi nhánh có cảnh báo" styleClass="kpi-label" />
            <Label fx:id="lowStockValue" text="0" styleClass="kpi-value" />
            <Label text="Có tồn dưới ngưỡng" styleClass="kpi-badge-warning" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-red">
            <Label text="Mặt hàng tồn thấp" styleClass="kpi-label" />
            <Label fx:id="outOfStockValue" text="0" styleClass="kpi-value" />
            <Label text="Theo ngưỡng tồn kho" styleClass="kpi-badge-danger" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="kpi-card kpi-card-green">
            <Label text="Giá trị tồn kho" styleClass="kpi-label" />
            <Label fx:id="inventoryValue" text="0M" styleClass="kpi-value" />
            <Label fx:id="inventoryGrowthBadge" text="0%" styleClass="kpi-badge-neutral" />
        </VBox>
    </HBox>

    <HBox styleClass="chart-row">
        <VBox HBox.hgrow="ALWAYS" styleClass="chart-card chart-card-large">
            <VBox spacing="4">
                <Label text="Cảnh báo tồn kho theo chi nhánh" styleClass="section-title" />
                <Label text="Trục X là chi nhánh, trục Y là số cảnh báo" styleClass="section-subtitle" />
            </VBox>
            <BarChart fx:id="branchWarningChart" animated="false" legendVisible="false" prefHeight="300" styleClass="report-chart">
                <xAxis>
                    <CategoryAxis label="Chi nhánh" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Cảnh báo" />
                </yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="360" styleClass="info-card" spacing="14">
            <VBox spacing="4">
                <Label fx:id="categoryChartTitleLabel" text="Cơ cấu tồn kho theo nhóm" styleClass="section-title" />
                <Label text="Tỷ trọng giá trị tồn kho" styleClass="section-subtitle" />
            </VBox>
            <PieChart fx:id="categoryPieChart" prefHeight="210" legendVisible="true" />
            <VBox spacing="8">
                <HBox>
                    <Label fx:id="warningBranch1Name" text="-" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="warningBranch1Value" text="0 cảnh báo" styleClass="status-badge status-danger" />
                </HBox>
                <HBox>
                    <Label fx:id="warningBranch2Name" text="-" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="warningBranch2Value" text="0 cảnh báo" styleClass="status-badge status-warning" />
                </HBox>
                <HBox>
                    <Label fx:id="warningBranch3Name" text="-" styleClass="report-list-label" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="warningBranch3Value" text="0 cảnh báo" styleClass="status-badge status-warning" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Bảng tồn kho nguyên liệu" styleClass="section-title" />
            <Label text="Nguyên liệu, chi nhánh, số tồn, ngưỡng an toàn và giá trị tồn" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="inventoryTable" prefHeight="320" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="branchColumn" text="Nguyên liệu" prefWidth="190" />
                <TableColumn fx:id="trackedColumn" text="Chi nhánh" prefWidth="150" />
                <TableColumn fx:id="lowStockColumn" text="Tồn hiện tại" prefWidth="110" />
                <TableColumn fx:id="outOfStockColumn" text="Ngưỡng an toàn" prefWidth="120" />
                <TableColumn fx:id="valueColumn" text="Giá trị tồn" prefWidth="150" />
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>
</VBox>
