<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.inventory.TransferFormController"
      styleClass="page-root">
    <VBox styleClass="form-card" spacing="18">
        <VBox spacing="4">
            <Label text="Thông tin điều chuyển kho" styleClass="section-title" />
            <Label text="Kho nguồn cố định theo chi nhánh hiện tại. Chọn kho đích và nhập số lượng điều chuyển thực tế." styleClass="section-subtitle" />
        </VBox>
        <GridPane styleClass="form-grid">
            <Label text="Kho nguồn" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="sourceComboBox" promptText="Kho nguồn" prefWidth="260" styleClass="page-combo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Kho đích" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <ComboBox fx:id="targetComboBox" promptText="Chọn kho đích" prefWidth="260" styleClass="page-combo" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Label text="Ghi chú" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextArea fx:id="noteArea" promptText="Schema hiện tại chưa có cột lưu lý do điều chuyển, ô này chỉ phục vụ thao tác nhập liệu." prefRowCount="2" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3" />
        </GridPane>
        <HBox styleClass="form-actions">
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Gửi duyệt điều chuyển" onAction="#saveTransfer" styleClass="primary-button" />
        </HBox>
    </VBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Chi tiết điều chuyển" styleClass="section-title" />
            <Label text="Chỉ các dòng có số lượng điều chuyển lớn hơn 0 mới được đưa vào phiếu." styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="transferTable" editable="true" prefHeight="430" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="codeColumn" text="Mã NL" prefWidth="110" />
                <TableColumn fx:id="materialColumn" text="Nguyên liệu" prefWidth="240" />
                <TableColumn fx:id="unitColumn" text="Đơn vị" prefWidth="100" />
                <TableColumn fx:id="quantityColumn" text="Tồn khả dụng" prefWidth="130" />
                <TableColumn fx:id="requestQuantityColumn" text="SL điều chuyển" prefWidth="140" />
                <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="140" />
            </columns>
        </TableView>
    </VBox>
</VBox>
