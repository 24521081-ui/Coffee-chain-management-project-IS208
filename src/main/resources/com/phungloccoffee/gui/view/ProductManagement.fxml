<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-root product-management-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.phungloccoffee.gui.controller.product.ProductManagementController">
    <VBox spacing="16" styleClass="table-card product-list-card product-list-card-full" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="product-card-heading">
            <VBox alignment="CENTER_LEFT" spacing="4">
                <Label styleClass="section-title" text="Danh sách sản phẩm" />
                <Label styleClass="section-subtitle" text="Menu bán hàng, giá bán và trạng thái kinh doanh" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addProductButton" onAction="#showAddProductDialog" styleClass="primary-action-button product-add-button" text="+ Thêm sản phẩm" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="product-search-bar">
            <TextField fx:id="searchField" maxWidth="480" prefWidth="390" promptText="Tìm kiếm sản phẩm theo mã hoặc tên" styleClass="page-input product-search-input" HBox.hgrow="SOMETIMES" />
            <Button onAction="#applySearchFilter" styleClass="secondary-action-button product-filter-button" text="Tìm kiếm" />
            <Button onAction="#clearFilter" styleClass="secondary-action-button product-filter-button" text="Xóa lọc" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="product-toolbar-row">
            <Label fx:id="resultCountLabel" styleClass="product-result-count" text="Hiển thị 0/0 sản phẩm" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="8" styleClass="product-action-group">
                <Button fx:id="detailButton" onAction="#showProductDetails" styleClass="soft-outline-button product-row-action-button" text="Xem chi tiết" />
                <Button fx:id="recipeButton" onAction="#showRecipeDialog" styleClass="secondary-action-button product-row-action-button" text="Cập nhật định mức" />
                <Button fx:id="editButton" onAction="#showUpdateProductDialog" styleClass="secondary-action-button product-row-action-button" text="Cập nhật thông tin" />
            </HBox>
        </HBox>

        <TableView fx:id="productTable" styleClass="page-table product-table-wide" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codeColumn" prefWidth="150" text="Mã sản phẩm" />
                <TableColumn fx:id="nameColumn" prefWidth="340" text="Tên sản phẩm" />
                <TableColumn fx:id="priceColumn" prefWidth="155" text="Giá" />
                <TableColumn fx:id="statusColumn" prefWidth="185" text="Trạng thái" />
                <TableColumn fx:id="recipeStatusColumn" prefWidth="145" text="Định mức" />
            </columns>
        </TableView>
    </VBox>
</VBox>
