<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.pos.PaymentController"
      styleClass="page-root">
    <HBox styleClass="main-layout" VBox.vgrow="ALWAYS">
        <VBox styleClass="form-card" spacing="18" HBox.hgrow="ALWAYS">
            <VBox spacing="4">
                <Label text="Thong tin thanh toan" styleClass="section-title" />
                <Label text="Nhap hoa don va phuong thuc nhan tien" styleClass="section-subtitle" />
            </VBox>
            <GridPane hgap="16" vgap="14" styleClass="form-grid">
                <Label text="Ma hoa don" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label" />
                <TextField fx:id="orderIdField" promptText="Nhap ID hoa don" prefWidth="320" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="page-input" />
                <Label text="Phuong thuc" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label" />
                <ComboBox fx:id="methodComboBox" promptText="Chon phuong thuc" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="page-combo" />
                <Label text="So tien" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label" />
                <TextField fx:id="amountField" promptText="0" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="page-input" />
            </GridPane>
            <HBox alignment="CENTER_RIGHT">
                <Button fx:id="confirmPaymentButton" text="Xác nhận thanh toán" onAction="#handleConfirmPayment" styleClass="primary-button" />
            </HBox>
        </VBox>

        <VBox styleClass="info-card" spacing="16" prefWidth="360">
            <VBox spacing="4">
                <Label text="Tom tat giao dich" styleClass="section-title" />
                <Label text="Doi soat nhanh truoc khi xac nhan" styleClass="section-subtitle" />
            </VBox>
            <VBox spacing="12">
                <HBox>
                    <Label text="Trang thai" styleClass="section-subtitle" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="statusLabel" text="Cho thanh toan" styleClass="status-badge status-warning" />
                </HBox>
                <HBox>
                    <Label text="Tong tien" styleClass="section-subtitle" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="totalLabel" text="0" styleClass="report-list-label" />
                </HBox>
                <VBox spacing="6">
                    <Label text="Mon hang" styleClass="section-subtitle" />
                    <Label fx:id="itemsLabel" text="Chua tai hoa don" wrapText="true" styleClass="report-list-label" />
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
