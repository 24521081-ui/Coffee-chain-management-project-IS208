<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.phungloccoffee.gui.controller.pos.PaymentHistoryController"
      styleClass="page-root">
    <HBox styleClass="filter-card report-controls-row">
        <TextField promptText="Tim hoa don, thu ngan..." prefWidth="260" styleClass="page-input" />
        <ComboBox promptText="Phuong thuc" prefWidth="170" styleClass="page-combo" />
        <ComboBox promptText="Trang thai" prefWidth="150" styleClass="page-combo" />
        <Button text="Tai lai" onAction="#loadHistory" styleClass="secondary-button" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">
        <VBox spacing="4">
            <Label text="Danh sach giao dich" styleClass="section-title" />
            <Label text="Theo doi thanh toan va trang thai doi soat" styleClass="section-subtitle" />
        </VBox>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="page-table">
            <columns>
                <TableColumn fx:id="orderCodeColumn" text="Hoa don" prefWidth="130" />
                <TableColumn fx:id="cashierColumn" text="Thu ngan" prefWidth="180" />
                <TableColumn fx:id="methodColumn" text="Phuong thuc" prefWidth="130" />
                <TableColumn fx:id="amountColumn" text="So tien" prefWidth="130" />
                <TableColumn fx:id="paidAtColumn" text="Thoi gian" prefWidth="170" />
                <TableColumn fx:id="statusColumn" text="Trang thai" prefWidth="140" />
                <TableColumn fx:id="actionColumn" text="Thao tac" prefWidth="130" />
            </columns>
        </TableView>
    </VBox>
</VBox>
